generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  TO_VERIFY
  PAID
}

enum OrderStatus {
  NEW
  CONFIRMED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  vendors   Vendor[]
}

model Vendor {
  id            String       @id @default(cuid())
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  category      String
  city          String
  neighborhood  String?
  description   String?
  phone         String
  priceInfo     String?
  latitude      Float?
  longitude     Float?
  status        VendorStatus @default(APPROVED)
  featured      Boolean      @default(false)
  featuredUntil DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  photos        Photo[]
  reviews       Review[]
  products      Product[]
  orders        Order[]

  @@index([city])
  @@index([category])
  @@index([status])
}

model Product {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       String?
  photoUrl    String?
  status      ProductStatus @default(APPROVED)
  stock       Int?                          // vide = stock non suivi (jamais « épuisé »)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
}

model Photo {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([vendorId])
}

// Une commande peut contenir les produits de plusieurs vendeurs, avec une seule livraison.
// Les noms et prix sont copiés au moment de l'achat
// (le catalogue peut changer ensuite) et l'historique est conservé si le vendeur est supprimé.
model Order {
  id              String      @id @default(cuid())
  reference       String      @unique        // ex. ACI-7KQ2MX, communiquée au client
  vendorId        String?
  vendor          Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorName      String?                    // vide si la commande contient plusieurs vendeurs
  buyerId         String?                    // vide si le client n'a pas de compte
  buyerName       String
  buyerPhone      String
  deliveryCity    String
  deliveryAddress String
  note            String?
  status          OrderStatus @default(NEW)
  subtotalFcfa    Int         @default(0)    // produits seulement
  shippingFeeFcfa Int         @default(0)    // UNE seule livraison, quel que soit le nombre de vendeurs
  totalFcfa       Int                        // produits + livraison
  paymentMethod   String?                    // ORANGE, MTN, MOOV ou WAVE
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentRef      String?                    // identifiant de transaction saisi par le client
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([vendorId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  vendorId      String?                    // vendeur à qui appartient ce produit
  vendorName    String?
  nameSnapshot  String
  unitPriceFcfa Int
  quantity      Int

  @@index([vendorId])
}

// Tarif de livraison par ville (en FCFA). Une ville sans tarif utilise le tarif par défaut.
model ShippingRate {
  id        String   @id @default(cuid())
  city      String   @unique
  feeFcfa   Int
  updatedAt DateTime @updatedAt
}

// Réglages modifiables depuis l'administration (livraison par défaut, seuil de livraison offerte…).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
