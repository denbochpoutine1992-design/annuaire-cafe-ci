# Base de données Postgres (Neon, Supabase, Railway, etc.)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/annuaire_cafe?sslmode=require"

# Clé secrète pour signer les sessions (générez une chaîne aléatoire longue)
# Exemple pour en générer une: openssl rand -base64 32
AUTH_SECRET="changez-moi-en-une-longue-chaine-aleatoire"

# Cloudinary (upload de photos) - créez un compte gratuit sur cloudinary.com
# Dans Settings > Upload, créez un "upload preset" en mode "Unsigned"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="votre-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="votre-upload-preset"
